# ===== 여기 3개만 채우면 됩니다 (전부 무료) =====

# 1) Gemini API 키 — https://aistudio.google.com/apikey 에서 무료 발급 (카드 등록 불필요)
GEMINI_API_KEY=여기에_붙여넣기

# 2) 텔레그램 봇 토큰 — 텔레그램에서 @BotFather 에게 /newbot 하면 발급
TELEGRAM_BOT_TOKEN=여기에_붙여넣기

# 3) 텔레그램 chat_id — get_chat_id.py 실행하면 알려줍니다
TELEGRAM_CHAT_ID=여기에_붙여넣기

# (선택) 사용할 모델
GEMINI_MODEL=gemini-flash-latest
