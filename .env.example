# ===== 여기 3개만 채우면 됩니다 =====

# 1) LLM API 키 — OpenAI 호환 게이트웨이(chat/completions) 사용처의 키
LLM_API_KEY=여기에_붙여넣기

# 2) 텔레그램 봇 토큰 — 텔레그램에서 @BotFather 에게 /newbot 하면 발급
TELEGRAM_BOT_TOKEN=여기에_붙여넣기

# 3) 텔레그램 chat_id — get_chat_id.py 실행하면 알려줍니다
TELEGRAM_CHAT_ID=여기에_붙여넣기

# (선택) 게이트웨이 주소/모델을 바꾸고 싶으면 아래 주석을 풀고 수정
# LLM_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
# LLM_MODEL=gpt-5.6-luna

# (선택) 실시간 모니터 확인 간격. 기본 1분
# LIVE_POLL_INTERVAL_MINUTES=1
